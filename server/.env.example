# Copy this file to ".env" (same folder) and fill in your values.

PORT=5000

# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/classoptima
# MongoDB Atlas (replace user, password and cluster):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/classoptima?retryWrites=true&w=majority

# Any long random string. Never commit the real one.
JWT_SECRET=change_this_to_a_long_random_string

# Shown on PDF exports
COLLEGE_NAME=ClassOptima Institute of Technology

# Used for the "Happening Now" live lecture tracker
TIMEZONE=Asia/Kolkata

# Allowed frontend origin(s), comma separated (optional in development)
# CLIENT_URL=http://localhost:5173
