{
  "name": "classoptima",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n api,web -c yellow,cyan \"npm --prefix server run dev\" \"vite\"",
    "build": "vite build",
    "lint": "eslint .",
